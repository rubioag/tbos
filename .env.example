# TBOS configuration template. Copy to .env and fill in your own values.
# .env is git-ignored and must never be committed.

# --- Odds providers ---
# Active provider. Free tier covers ATP/WTA 250 events; required for `tbos paper-run`.
TBOS_ODDS_API_IO_KEY=

# Legacy provider, kept for the older adapter. Optional.
TBOS_ODDS_API_KEY=

# --- Infrastructure ---
# Defaults below match docker-compose.yml. Override only if you run your own services.
TBOS_DATABASE_URL=postgresql+psycopg://tbos:tbos_dev_password@localhost:5432/tbos
TBOS_REDIS_URL=redis://localhost:6379/0
